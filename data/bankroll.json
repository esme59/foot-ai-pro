import os
import json
import math
import time
from datetime import datetime, timedelta, timezone

import requests

# ============================================================
# FOOT AI PRO BOT V5
# Simulation virtuelle uniquement - aucun pari réel
# ============================================================

API_BASE = "https://api.football-data.org/v4"
STATE_FILE = "data/bankroll.json"

COMPETITIONS = {
    "Ligue 1": "FL1",
    "Premier League": "PL",
    "Liga": "PD",
    "Bundesliga": "BL1",
    "Serie A": "SA",
    "Ligue des Champions": "CL",
}

CAPITAL_INITIAL = 20.00
MISE_MAXIMUM = 1.00
MAX_PARIS_PAR_JOUR = 5

JOURS_A_VENIR = 3
JOURS_HISTORIQUE = 60

PROBA_PRUDENTE = 0.72
PROBA_RISQUEE = 0.50

FRACTION_PRUDENTE = 0.02
FRACTION_RISQUEE = 0.015

# Une session HTTP réutilisable
SESSION = requests.Session()


# ============================================================
# ÉTAT ET SAUVEGARDE
# ============================================================

def load_state():
    os.makedirs("data", exist_ok=True)

    if not os.path.exists(STATE_FILE):
        return {
            "starting_bankroll": CAPITAL_INITIAL,
            "bankroll": CAPITAL_INITIAL,
            "day": "",
            "bets": [],
            "history": [],
            "message": "Capital virtuel initialisé.",
            "stats": {},
        }

    try:
        with open(STATE_FILE, "r", encoding="utf-8") as file:
            state = json.load(file)
    except (json.JSONDecodeError, OSError) as error:
        raise RuntimeError(
            "Impossible de lire bankroll.json. "
            "Le fichier original doit être conservé."
        ) from error

    if not isinstance(state, dict):
        raise RuntimeError("Le contenu de bankroll.json est invalide.")

    state.setdefault("starting_bankroll", CAPITAL_INITIAL)
    state.setdefault("bankroll", CAPITAL_INITIAL)
    state.setdefault("bets", [])
    state.setdefault("history", [])
    state.setdefault("message", "")
    state.setdefault("day", "")
    state.setdefault("stats", {})

    if not isinstance(state["bets"], list):
        raise RuntimeError("La liste des paris est invalide.")

    if not isinstance(state["history"], list):
        state["history"] = []

    return state


def save_state(state):
    os.makedirs("data", exist_ok=True)

    temp_file = STATE_FILE + ".tmp"

    with open(temp_file, "w", encoding="utf-8") as file:
        json.dump(
            state,
            file,
            ensure_ascii=False,
            indent=2,
        )

    os.replace(temp_file, STATE_FILE)


# ============================================================
# API FOOTBALL-DATA.ORG
# ============================================================

def get_matches(competition, date_from, date_to, api_key):
    url = f"{API_BASE}/competitions/{competition}/matches"

    response = SESSION.get(
        url,
        headers={"X-Auth-Token": api_key},
        params={
            "dateFrom": date_from,
            "dateTo": date_to,
        },
        timeout=25,
    )

    if response.status_code == 429:
        raise RuntimeError(
            "Limite API atteinte (429). Réessaie plus tard."
        )

    if response.status_code == 403:
        raise RuntimeError(
            f"Accès refusé à {competition} (403). "
            "Vérifie les compétitions autorisées par ton abonnement."
        )

    response.raise_for_status()

    data = response.json()
    return data.get("matches", [])


def get_match_by_id(match_id, api_key):
    """
    Recherche un match directement par son identifiant.

    Cette fonction sert de solution de secours lorsqu'un pari
    en attente ne trouve pas son match dans les listes des ligues.
    """

    if match_id is None or str(match_id).strip() == "":
        return None

    url = f"{API_BASE}/matches/{match_id}"

    response = SESSION.get(
        url,
        headers={"X-Auth-Token": api_key},
        timeout=20,
    )

    if response.status_code == 404:
        print(f"Match {match_id} introuvable dans l'API.")
        return None

    if response.status_code == 429:
        raise RuntimeError(
            "Limite API atteinte pendant la recherche des résultats."
        )

    if response.status_code == 403:
        print(
            f"Accès refusé pour le match {match_id}. "
            "Il peut ne pas être disponible avec cet abonnement."
        )
        return None

    response.raise_for_status()

    data = response.json()

    # Certaines réponses peuvent envelopper le match dans une clé.
    if isinstance(data, dict) and isinstance(data.get("match"), dict):
        data = data["match"]

    if not isinstance(data, dict):
        return None

    data["id"] = data.get("id", match_id)

    return data


def is_finished_status(status):
    return status in ("FINISHED", "AWARDED")


def parse_match_date(match):
    utc_date = match.get("utcDate", "")

    if not utc_date:
        return None

    try:
        return datetime.fromisoformat(
            utc_date.replace("Z", "+00:00")
        )
    except (ValueError, AttributeError):
        return None


# ============================================================
# MODÈLE DE POISSON
# ============================================================

def poisson(mean, goals):
    if mean <= 0:
        return 1.0 if goals == 0 else 0.0

    return math.exp(-mean) * mean ** goals / math.factorial(goals)


# ============================================================
# ANALYSE DES MATCHS
# ============================================================

def predict_match(matches, home_team, away_team):
    league_home = []
    league_away = []

    home_scored = []
    home_conceded = []

    away_scored = []
    away_conceded = []

    for match in matches:
        if match.get("status") != "FINISHED":
            continue

        score = match.get("score", {}).get("fullTime", {})

        home_goals = score.get("home")
        away_goals = score.get("away")

        if home_goals is None or away_goals is None:
            continue

        home_name = match.get("homeTeam", {}).get("name", "")
        away_name = match.get("awayTeam", {}).get("name", "")

        league_home.append(home_goals)
        league_away.append(away_goals)

        if home_name == home_team:
            home_scored.append(home_goals)
            home_conceded.append(away_goals)
        elif away_name == home_team:
            home_scored.append(away_goals)
            home_conceded.append(home_goals)

        if home_name == away_team:
            away_scored.append(home_goals)
            away_conceded.append(away_goals)
        elif away_name == away_team:
            away_scored.append(away_goals)
            away_conceded.append(home_goals)

    if not league_home:
        return None

    avg_home = sum(league_home) / len(league_home)
    avg_away = sum(league_away) / len(league_away)

    def average(values, fallback):
        return sum(values) / len(values) if values else fallback

    home_attack = average(home_scored, avg_home)
    home_defense = average(home_conceded, avg_away)

    away_attack = average(away_scored, avg_away)
    away_defense = average(away_conceded, avg_home)

    if len(home_scored) < 5:
        home_attack = (
            home_attack * len(home_scored) + avg_home * 5
        ) / (len(home_scored) + 5)

        home_defense = (
            home_defense * len(home_conceded) + avg_away * 5
        ) / (len(home_conceded) + 5)

    if len(away_scored) < 5:
        away_attack = (
            away_attack * len(away_scored) + avg_away * 5
        ) / (len(away_scored) + 5)

        away_defense = (
            away_defense * len(away_conceded) + avg_home * 5
        ) / (len(away_conceded) + 5)

    lambda_home = max(
        0.20,
        min(3.40, 0.55 * home_attack + 0.45 * away_defense),
    )

    lambda_away = max(
        0.20,
        min(3.40, 0.55 * away_attack + 0.45 * home_defense),
    )

    scores = {}

    for home_goals in range(9):
        for away_goals in range(9):
            scores[(home_goals, away_goals)] = (
                poisson(lambda_home, home_goals)
                * poisson(lambda_away, away_goals)
            )

    total_probability = sum(scores.values())

    if total_probability <= 0:
        return None

    def probability(condition):
        return sum(
            value
            for (home_goals, away_goals), value in scores.items()
            if condition(home_goals, away_goals)
        ) / total_probability

    markets = {
        "Plus de 1,5 but": probability(
            lambda h, a: h + a >= 2
        ),
        "Plus de 2,5 buts": probability(
            lambda h, a: h + a >= 3
        ),
        "Moins de 2,5 buts": probability(
            lambda h, a: h + a <= 2
        ),
        "Moins de 3,5 buts": probability(
            lambda h, a: h + a <= 3
        ),
        "Les deux équipes marquent : oui": probability(
            lambda h, a: h > 0 and a > 0
        ),
        "Les deux équipes marquent : non": probability(
            lambda h, a: h == 0 or a == 0
        ),
        "Victoire domicile": probability(
            lambda h, a: h > a
        ),
        "Match nul": probability(
            lambda h, a: h == a
        ),
        "Victoire extérieur": probability(
            lambda h, a: h < a
        ),
        "Double chance 1X": probability(
            lambda h, a: h >= a
        ),
        "Double chance X2": probability(
            lambda h, a: a >= h
        ),
    }

    exact_score = max(scores, key=scores.get)

    sample = min(len(home_scored), len(away_scored))

    return {
        "home": home_team,
        "away": away_team,
        "markets": {
            name: round(value, 4)
            for name, value in markets.items()
        },
        "score": f"{exact_score[0]}-{exact_score[1]}",
        "lambda_home": round(lambda_home, 3),
        "lambda_away": round(lambda_away, 3),
        "sample": sample,
    }


# ============================================================
# SÉLECTION DES MARCHÉS
# ============================================================

def select_pick(prediction, used_markets):
    allowed = []

    for name, probability in prediction["markets"].items():
        if name in used_markets:
            continue

        if probability < PROBA_RISQUEE or probability >= 0.96:
            continue

        if probability > 0.90:
            continue

        allowed.append((name, probability))

    if not allowed:
        return None

    allowed.sort(key=lambda item: item[1], reverse=True)

    return allowed[0]


def choose_strategy(probability, sample):
    if probability >= PROBA_PRUDENTE and sample >= 4:
        return "Prudent"

    if probability >= PROBA_RISQUEE and sample >= 2:
        return "Risqué"

    return None


def calculate_stake(bankroll, strategy):
    if bankroll <= 0:
        return 0.0

    fraction = (
        FRACTION_PRUDENTE
        if strategy == "Prudent"
        else FRACTION_RISQUEE
    )

    return round(min(MISE_MAXIMUM, bankroll * fraction), 2)


# ============================================================
# ÉVALUATION DES PARIS
# ============================================================

def evaluate_pick(pick, home, away):
    total = home + away

    rules = {
        "Plus de 1,5 but": total >= 2,
        "Plus de 2,5 buts": total >= 3,
        "Moins de 2,5 buts": total <= 2,
        "Moins de 3,5 buts": total <= 3,
        "Les deux équipes marquent : oui": home > 0 and away > 0,
        "Les deux équipes marquent : non": home == 0 or away == 0,
        "Victoire domicile": home > away,
        "Match nul": home == away,
        "Victoire extérieur": home < away,
        "Double chance 1X": home >= away,
        "Double chance X2": away >= home,
    }

    # None signifie que le marché n'est pas reconnu.
    return rules.get(pick)


# ============================================================
# RÈGLEMENT DES PARIS
# ============================================================

def settle_bets(state, matches_by_id):
    changed = 0

    for bet in state["bets"]:
        # Ne jamais régler deux fois un pari déjà traité.
        if bet.get("settled"):
            continue

        match_id = str(bet.get("match_id", ""))

        if not match_id:
            continue

        match = matches_by_id.get(match_id)

        if not match:
            continue

        if not is_finished_status(match.get("status")):
            continue

        score = match.get("score", {}).get("fullTime", {})

        home_goals = score.get("home")
        away_goals = score.get("away")

        if home_goals is None or away_goals is None:
            print(
                f"Match {match_id} terminé mais score final indisponible."
            )
            continue

        try:
            home_goals = int(home_goals)
            away_goals = int(away_goals)
        except (ValueError, TypeError):
            continue

        # Certains anciens paris peuvent utiliser un autre champ.
        pick = bet.get("pick") or bet.get("market") or bet.get("selection")

        won = evaluate_pick(pick, home_goals, away_goals)

        if won is None:
            bet["result"] = "Marché à vérifier"
            print(
                f"Marché inconnu pour le match {match_id}: {pick}"
            )
            continue

        try:
            stake = max(0.0, float(bet.get("stake", 0) or 0))
        except (ValueError, TypeError):
            stake = 0.0

        try:
            probability = float(
                bet.get("probability", 0.5) or 0.5
            )
        except (ValueError, TypeError):
            probability = 0.5

        probability = max(0.05, min(0.95, probability))
        virtual_odds = round(0.92 / probability, 2)

        profit = (
            round(stake * (virtual_odds - 1), 2)
            if won
            else round(-stake, 2)
        )

        final_score = f"{home_goals}-{away_goals}"

        bet.update({
            "settled": True,
            "result": "Gagné" if won else "Perdu",
            "actual_score": final_score,
            "score_final": final_score,
            "match_status": match.get("status"),
            "virtual_odds": virtual_odds,
            "profit": profit,
            "settled_at": datetime.now(timezone.utc).isoformat(),
        })

        state["bankroll"] = round(
            float(state.get("bankroll", CAPITAL_INITIAL)) + profit,
            2,
        )

        changed += 1

        print(
            f"PARI RÉGLÉ : {bet.get('home', '?')} - "
            f"{bet.get('away', '?')} | {final_score} | "
            f"{bet['result']} | Profit : {profit:.2f} €"
        )

    return changed


# ============================================================
# RÉCUPÉRATION DES MATCHS MANQUANTS
# ============================================================

def refresh_pending_matches(state, matches_by_id, api_key):
    """
    Pour chaque pari non réglé :
    - utilise d'abord les matchs récupérés par compétition ;
    - si le match manque ou paraît terminé mais n'a pas été actualisé,
      essaie de le récupérer directement par son identifiant ;
    - limite les requêtes et arrête si l'API renvoie une limite 429.
    """

    pending_ids = {}

    for bet in state.get("bets", []):
        if bet.get("settled"):
            continue

        match_id = str(bet.get("match_id", ""))

        if not match_id:
            continue

        match = matches_by_id.get(match_id)

        if match and is_finished_status(match.get("status")):
            score = match.get("score", {}).get("fullTime", {})

            if score.get("home") is not None and score.get("away") is not None:
                continue

        # Si le match est absent, ou n'est pas encore marqué terminé,
        # le point de terminaison direct peut fournir un statut plus récent.
        pending_ids[match_id] = match

    refreshed = 0

    for match_id, old_match in pending_ids.items():
        try:
            # Évite de dépasser trop rapidement le quota API.
            time.sleep(6)

            match = get_match_by_id(match_id, api_key)

            if match:
                matches_by_id[match_id] = match
                refreshed += 1

                print(
                    f"Match actualisé {match_id}: "
                    f"{match.get('status', 'statut inconnu')}"
                )

        except RuntimeError as error:
            print(f"ARRÊT récupération directe : {error}")
            break

        except requests.RequestException as error:
            print(
                f"Impossible d'actualiser le match {match_id}: {error}"
            )

    print(
        f"Recherche directe terminée : "
        f"{refreshed} match(s) actualisé(s)."
    )

    return refreshed


# ============================================================
# HISTORIQUE ET STATISTIQUES
# ============================================================

def update_daily_history(state, today):
    bets = state.get("bets", [])

    settled = [
        bet for bet in bets
        if bet.get("settled")
        and bet.get("result") in ("Gagné", "Perdu")
    ]

    wins = sum(
        bet.get("result") == "Gagné"
        for bet in settled
    )

    losses = sum(
        bet.get("result") == "Perdu"
        for bet in settled
    )

    cumulative_profit = round(
        sum(float(bet.get("profit") or 0) for bet in settled),
        2,
    )

    state["stats"] = {
        "wins": wins,
        "losses": losses,
        "settled": len(settled),
        "win_rate": round(
            100 * wins / len(settled), 2
        ) if settled else 0.0,
        "profit": cumulative_profit,
        "bankroll": round(
            float(state.get("bankroll", CAPITAL_INITIAL)),
            2,
        ),
    }

    entry = {
        "date": today,
        "bankroll": round(
            float(state.get("bankroll", CAPITAL_INITIAL)),
            2,
        ),
        "bets_total": len(bets),
        "open_bets": sum(
            not bet.get("settled")
            for bet in bets
        ),
        "wins": wins,
        "losses": losses,
        "profit": cumulative_profit,
    }

    history = [
        item for item in state.get("history", [])
        if item.get("date") != today
    ]

    history.append(entry)
    history.sort(key=lambda item: item.get("date", ""))

    state["history"] = history[-180:]


# ============================================================
# COMPTER LES PARIS CRÉÉS AUJOURD'HUI
# ============================================================

def count_bets_today(bets, today):
    return sum(
        1 for bet in bets
        if str(bet.get("created_day", ""))[:10] == today
    )


# ============================================================
# EXÉCUTION PRINCIPALE
# ============================================================

def main():
    api_key = os.getenv("FOOTBALL_DATA_API_KEY", "").strip()

    if not api_key:
        raise SystemExit(
            "Clé API absente. Vérifie le secret "
            "FOOTBALL_DATA_API_KEY dans GitHub Actions."
        )

    state = load_state()

    now = datetime.now(timezone.utc)
    today = now.date()
    today_string = today.isoformat()

    date_from = (
        today - timedelta(days=JOURS_HISTORIQUE)
    ).isoformat()

    date_to = (
        today + timedelta(days=JOURS_A_VENIR)
    ).isoformat()

    all_matches = []
    errors = []

    # Une requête par compétition, comme dans l'ancienne version.
    for league, code in COMPETITIONS.items():
        try:
            matches = get_matches(
                code,
                date_from,
                date_to,
                api_key,
            )

            for match in matches:
                match["_league_name"] = league

            all_matches.extend(matches)

        except (requests.RequestException, RuntimeError) as error:
            errors.append(f"{league}: {error}")
            print(f"AVERTISSEMENT {league}: {error}")

    matches_by_id = {
        str(match["id"]): match
        for match in all_matches
        if match.get("id") is not None
    }

    # NOUVEAU : actualiser les matchs liés aux paris en attente.
    refresh_pending_matches(
        state,
        matches_by_id,
        api_key,
    )

    # Régler les paris dont le score final est maintenant disponible.
    settled_count = settle_bets(
        state,
        matches_by_id,
    )

    existing_match_ids = {
        str(bet.get("match_id"))
        for bet in state["bets"]
        if bet.get("match_id") is not None
    }

    bets_today = count_bets_today(
        state["bets"],
        today_string,
    )

    remaining_slots = max(
        0,
        MAX_PARIS_PAR_JOUR - bets_today,
    )

    used_markets = {
        bet.get("pick")
        for bet in state["bets"]
        if str(bet.get("created_day", ""))[:10] == today_string
    }

    candidates = []

    for match in matches_by_id.values():
        if match.get("status") not in ("SCHEDULED", "TIMED"):
            continue

        match_datetime = parse_match_date(match)

        if match_datetime is None:
            continue

        match_day = match_datetime.date()

        if not (
            today <= match_day <= today + timedelta(days=JOURS_A_VENIR)
        ):
            continue

        match_id = str(match.get("id", ""))

        if not match_id or match_id in existing_match_ids:
            continue

        home = match.get("homeTeam", {}).get("name", "")
        away = match.get("awayTeam", {}).get("name", "")

        if not home or not away:
            continue

        league = match.get("_league_name", "")

        # Les matchs récupérés directement servent au règlement.
        # Pour créer de nouveaux paris, on conserve les données des ligues.
        league_matches = [
            item for item in all_matches
            if item.get("_league_name") == league
        ]

        prediction = predict_match(
            league_matches,
            home,
            away,
        )

        if not prediction:
            continue

        selected = select_pick(
            prediction,
            used_markets,
        )

        if selected is None:
            selected = select_pick(
                prediction,
                set(),
            )

        if selected is None:
            continue

        pick, probability = selected

        strategy = choose_strategy(
            probability,
            prediction["sample"],
        )

        if strategy is None:
            continue

        prediction.update({
            "match_id": match_id,
            "league": league,
            "date": match_day.isoformat(),
            "utcDate": match.get("utcDate", ""),
            "pick": pick,
            "probability": probability,
            "strategy": strategy,
        })

        candidates.append(prediction)

    candidates.sort(
        key=lambda item: (
            item["strategy"] == "Prudent",
            item["probability"],
            item["sample"],
        ),
        reverse=True,
    )

    new_bets = []

    for prediction in candidates[:remaining_slots]:
        stake = calculate_stake(
            float(state.get("bankroll", CAPITAL_INITIAL)),
            prediction["strategy"],
        )

        if stake <= 0:
            break

        bet = {
            "home": prediction["home"],
            "away": prediction["away"],
            "pick": prediction["pick"],
            "probability": prediction["probability"],
            "sample": prediction["sample"],
            "score": prediction["score"],
            "lambda_home": prediction["lambda_home"],
            "lambda_away": prediction["lambda_away"],
            "match_id": prediction["match_id"],
            "league": prediction["league"],
            "date": prediction["date"],
            "utcDate": prediction["utcDate"],
            "strategy": prediction["strategy"],
            "stake": stake,
            "settled": False,
            "result": "En attente",
            "virtual_odds": None,
            "profit": None,
            "created_day": today_string,
            "settled_at": None,
        }

        state["bets"].append(bet)

        existing_match_ids.add(str(bet["match_id"]))
        used_markets.add(bet["pick"])

        new_bets.append(
            f'{bet["home"]} - {bet["away"]}: '
            f'{bet["pick"]} '
            f'({bet["probability"] * 100:.1f} %, '
            f'{bet["strategy"]}, mise {stake:.2f} €)'
        )

    state["day"] = now.isoformat()

    if new_bets:
        state["message"] = (
            f"{len(new_bets)} nouveau(x) pari(s) virtuel(s) : "
            + " | ".join(new_bets)
        )
    elif remaining_slots == 0:
        state["message"] = (
            f"Limite quotidienne atteinte : "
            f"{bets_today} pari(s) créé(s) aujourd'hui. "
            "Les paris en attente ont quand même été vérifiés."
        )
    elif errors:
        state["message"] = (
            "Erreurs API : " + " ; ".join(errors)
        )
    else:
        state["message"] = (
            "Aucun nouveau pari ne correspond aux critères. "
            "Les paris existants ont été vérifiés."
        )

    update_daily_history(
        state,
        today_string,
    )

    save_state(state)

    print(state["message"])
    print("Paris réglés pendant cette exécution :", settled_count)
    print("Capital virtuel :", state["bankroll"], "€")
    print("Paris enregistrés :", len(state["bets"]))
    print(
        "Paris créés aujourd'hui :",
        count_bets_today(state["bets"], today_string),
        "/",
        MAX_PARIS_PAR_JOUR,
    )
    print(
        "Statistiques :",
        json.dumps(state["stats"], ensure_ascii=False),
    )


if __name__ == "__main__":
    main()