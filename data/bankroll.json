import json
import shutil
from pathlib import Path
from datetime import datetime, date, timezone

# ============================================================
# NETTOYAGE DE LA BANKROLL VIRTUELLE FOOT AI PRO
# Conserve les matchs jusqu'au 25 octobre 2026 inclus.
# Sauvegarde le fichier original avant toute modification.
# ============================================================

FICHIER = Path("data/bankroll.json")
DATE_LIMITE = date(2026, 10, 25)


def date_du_match(pari):
    valeur = (
        pari.get("date_match")
        or pari.get("match_date")
        or pari.get("date")
    )

    if not valeur:
        raise ValueError(
            f"Date manquante pour le pari : {pari.get('match_id')}"
        )

    return datetime.fromisoformat(
        valeur.replace("Z", "+00:00")
    ).date()


def est_en_attente(pari):
    statut = str(
        pari.get("statut", pari.get("status", ""))
    ).strip().lower()

    return statut in {
        "en_attente",
        "en attente",
        "pending",
    }


def main():
    if not FICHIER.exists():
        print(f"ERREUR : fichier introuvable : {FICHIER}")
        return

    # Lecture et vérification avant modification.
    with FICHIER.open("r", encoding="utf-8") as fichier:
        donnees = json.load(fichier)

    paris = donnees.get("paris")

    if not isinstance(paris, list):
        print("ERREUR : la liste 'paris' est absente ou invalide.")
        return

    # Vérifier les dates avant de modifier quoi que ce soit.
    for pari in paris:
        date_du_match(pari)

    paris_conserves = []
    paris_supprimes = []

    for pari in paris:
        if date_du_match(pari) <= DATE_LIMITE:
            paris_conserves.append(pari)
        else:
            paris_supprimes.append(pari)

    # Calculer l'argent à restituer pour les paris supprimés
    # uniquement s'ils sont encore en attente.
    remboursement = sum(
        float(pari.get("mise", pari.get("stake", 0.0)))
        for pari in paris_supprimes
        if est_en_attente(pari)
    )

    # Ne pas écraser le fichier si aucun pari ne doit être supprimé.
    if not paris_supprimes:
        print("Aucun pari après le 25 octobre 2026.")
        print("Aucune modification effectuée.")
        return

    # Créer une sauvegarde.
    sauvegarde = FICHIER.with_name("bankroll.json.backup")
    shutil.copy2(FICHIER, sauvegarde)

    # Mettre à jour la liste principale.
    donnees["paris"] = paris_conserves

    # Synchroniser la liste utilisée par le tableau de bord.
    nouveaux_bets = []

    for pari in paris_conserves:
        bet = dict(pari)

        bet.setdefault("date", pari.get("date_match", ""))
        bet.setdefault("match_date", pari.get("date_match", ""))
        bet.setdefault("league", pari.get("competition", ""))
        bet.setdefault("home", pari.get("domicile", ""))
        bet.setdefault("home_team", pari.get("domicile", ""))
        bet.setdefault("away", pari.get("exterieur", ""))
        bet.setdefault("away_team", pari.get("exterieur", ""))
        bet.setdefault("pick", pari.get("marche", ""))
        bet.setdefault("market", pari.get("marche", ""))
        bet.setdefault("pronostic", pari.get("marche", ""))
        bet.setdefault("probability", pari.get("probabilite", 0.0))
        bet.setdefault("probability_pct", pari.get("probabilite", 0.0))
        bet.setdefault("odds", pari.get("cote_estimee", 0.0))
        bet.setdefault("stake", pari.get("mise", 0.0))
        bet.setdefault("status", "En attente")
        bet.setdefault("result", "En attente")
        bet.setdefault("score", pari.get("score_prevu", ""))
        bet.setdefault("actual_score", "")
        bet.setdefault("settled", False)
        bet.setdefault("profit", 0.0)

        nouveaux_bets.append(bet)

    donnees["bets"] = nouveaux_bets

    # Calculer les statistiques à partir des paris conservés.
    gagnes = sum(
        1 for pari in paris_conserves
        if str(pari.get("statut", "")).upper() == "GAGNE"
    )

    perdus = sum(
        1 for pari in paris_conserves
        if str(pari.get("statut", "")).upper() == "PERDU"
    )

    en_attente = sum(
        1 for pari in paris_conserves
        if est_en_attente(pari)
    )

    regles = gagnes + perdus
    taux = round((gagnes / regles) * 100, 2) if regles else 0.0

    donnees["statistiques"] = {
        "total_paris": len(paris_conserves),
        "paris_gagnes": gagnes,
        "paris_perdus": perdus,
        "paris_en_attente": en_attente,
        "taux_reussite": taux,
    }

    # Recalculer les sommes et restituer les mises supprimées.
    bankroll_initiale = float(
        donnees.get("bankroll_initiale", 20.0)
    )

    bankroll_actuelle = float(
        donnees.get(
            "bankroll_actuelle",
            donnees.get("bankroll", bankroll_initiale),
        )
    )

    donnees["bankroll_actuelle"] = round(
        bankroll_actuelle + remboursement, 2
    )
    donnees["bankroll"] = donnees["bankroll_actuelle"]
    donnees["starting_bankroll"] = bankroll_initiale

    donnees["mises_totales"] = round(
        sum(float(p.get("mise", 0.0)) for p in paris_conserves),
        2,
    )

    donnees["gains_totaux"] = round(
        sum(float(p.get("gain", 0.0)) for p in paris_conserves),
        2,
    )

    donnees["benefice_total"] = round(
        donnees["gains_totaux"]
        - sum(
            float(p.get("mise", 0.0))
            for p in paris_conserves
            if str(p.get("statut", "")).upper() == "PERDU"
        ),
        2,
    )

    donnees["profit"] = donnees["benefice_total"]
    donnees["derniere_mise_a_jour"] = (
        datetime.now(timezone.utc).isoformat()
    )
    donnees["day"] = donnees["derniere_mise_a_jour"]

    # Conserver les anciennes clés historiques sans les effacer.
    donnees["history"] = donnees.get("history", [])
    donnees["historique"] = donnees.get("historique", [])

    # Écriture atomique : le fichier temporaire est remplacé
    # seulement après la génération du nouveau JSON.
    temporaire = FICHIER.with_suffix(".json.tmp")

    with temporaire.open("w", encoding="utf-8") as fichier:
        json.dump(donnees, fichier, ensure_ascii=False, indent=2)
        fichier.write("\n")

    temporaire.replace(FICHIER)

    print("NETTOYAGE TERMINÉ")
    print("-----------------")
    print(f"Paris conservés : {len(paris_conserves)}")
    print(f"Paris supprimés : {len(paris_supprimes)}")
    print(f"Remboursement virtuel : {remboursement:.2f} €")
    print(
        "Capital disponible : "
        f"{donnees['bankroll_actuelle']:.2f} €"
    )
    print(f"Sauvegarde : {sauvegarde}")


if __name__ == "__main__":
    main()